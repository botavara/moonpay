services:
  postgres:
    image: postgres:17-alpine
    container_name: devops-postgres
    restart: always
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
    ports:
      - "${POSTGRES_PORT}:5432"
    volumes:
      - postgres-data:/var/lib/postgresql/data
    networks:
      - devops-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER}"]
      interval: 10s
      timeout: 5s
      retries: 5

  pgadmin:
    image: dpage/pgadmin4
    container_name: devops-pgadmin
    restart: always
    environment:
      PGADMIN_DEFAULT_EMAIL: ${PGADMIN_EMAIL}
      PGADMIN_DEFAULT_PASSWORD: ${PGADMIN_PASSWORD}
    ports:
      - "${PGADMIN_PORT}:80"
    networks:
      - devops-network
    depends_on:
      - postgres

  nextjs:
    build:
      context: .
      dockerfile: Dockerfile
      args:
        NODE_ENV: ${NODE_ENV}
    container_name: devops-nextjs
    restart: always
    environment:
      NODE_ENV: ${NODE_ENV}
      POSTGRES_PRISMA_URL: ${POSTGRES_PRISMA_URL}
      PORT: ${APP_PORT}
      HOSTNAME: "0.0.0.0"
    ports:
      - "${APP_PORT}:3000"
    networks:
      - devops-network
    depends_on:
      postgres:
        condition: service_healthy
    command: >
      sh -c "
        echo 'Running Prisma migrations...' &&
        pnpm prisma migrate deploy &&
        echo 'Running seed...' &&
        pnpm db:seed ||
        echo 'Seed failed or skipped' &&
        echo 'Starting Next.js' &&
        pnpm start
      "

    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:3000"]
      interval: 30s
      timeout: 10s
      retries: 3

networks:
  devops-network:
    driver: bridge

volumes:
  postgres-data:
    driver: local
